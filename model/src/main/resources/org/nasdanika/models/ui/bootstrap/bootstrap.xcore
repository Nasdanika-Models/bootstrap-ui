@Ecore(nsURI="https://bootstrap.models.nasdanika.org", nsPrefix="org.nasdanika.models.ui.bootstrap")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.ui.bootstrap

import org.nasdanika.models.ui.Checkbox
import org.nasdanika.models.ui.Container
import org.nasdanika.models.ui.Element
import org.nasdanika.models.ui.Layout
import org.nasdanika.models.ui.Text

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/* ---- Vocabulary ---- */

enum Color {
    PRIMARY
    SECONDARY
    SUCCESS
    DANGER
    WARNING
    INFO
    LIGHT
    DARK
}

enum Size {
    SMALL
    DEFAULT
    LARGE
}

enum Breakpoint {
    XS
    SM
    MD
    LG
    XL
    XXL
}

/* Bootstrap 5.3 color modes (data-bs-theme). */
enum ColorMode {
    LIGHT
    DARK
    AUTO
}

enum Placement {
    TOP
    BOTTOM
    START
    END
}

/* ---- Theming mixin ---- */

class Tooltip {
    String text
    Placement placement
}

/*
 * Mixin for Bootstrap theming: background, text, border colors, a local
 * color mode, and an optional tooltip. Mixed into Bootstrap classes
 * alongside their core UI supertypes.
 */
abstract class Themed {
    Color background
    Color textColor
    Color border
    ColorMode colorMode
    contains Tooltip tooltip
}

/* ---- Page and grid ---- */

/* Top-level page: color mode, generated into an HTML page with Bootstrap 5.3 assets. */
class Page extends Container, Themed {
    String title
}

/* Bootstrap grid row; children are typically Columns. */
class Row extends Layout {
}

/* Per-breakpoint width: 1..12, 0 meaning auto. */
class Span {
    Breakpoint breakpoint
    Integer width
}

class Column extends Container {
    contains Span[] spans
}

/* ---- Components ---- */

class Button extends org.nasdanika.models.ui.Button {
    Color color
    boolean outline
    Size size
}

class Alert extends Container, Themed {
    Color color
    boolean dismissible
}

class Badge extends Text {
    Color color
    boolean pill
}

class Card extends Container, Themed {
    String title
    contains Element header
    contains Element footer
    /* Image displayed at the top of the card. */
    String image
}

class Modal extends Container, Themed {
    String title
    Size size
    boolean centered
    boolean scrollable
}

class AccordionItem extends Container {
    String header
}

class Accordion extends Element {
    contains AccordionItem[] items
    boolean alwaysOpen
    boolean flush
}

class Navbar extends Container, Themed {
    /* Breakpoint at which the navbar expands from collapsed to horizontal. */
    Breakpoint expand
    String brand
    String brandLocation
}

enum SpinnerKind {
    BORDER
    GROW
}

class Spinner extends Element {
    SpinnerKind kind
    Color color
    Size size
}

class Progress extends Element {
    /* 0..100. */
    double value
    Color color
    boolean striped
    boolean animated
}

class Toast extends Container {
    String header
    Integer delay
    boolean autohide
}

/* Rendered as a form-switch. */
class Switch extends Checkbox {
}

